  "waterWildlifeSafety": {
    "policy": "Official-Only Verified Sources",
    "summary": "Nile crocodiles, hippos, and bilharzia (schistosomiasis) inhabit the River Nile, Kazinga Channel, and Lake Victoria shorelines, whereas high-altitude crater lakes (Lake Bunyonyi and Lake Mutanda) are free of crocodiles and hippos.",
    "lastVerified": "2026-11-18",
    "safeCraterLakes": [
      {
        "id": "lake_bunyonyi",
        "name": "Lake Bunyonyi (Kabale)",
        "elevationMeters": 1962,
        "status": "Crocodile & Hippo Free • Bilharzia Free",
        "rule": "High-altitude crater lake (~1,962m). Free of Nile crocodiles, hippos, and bilharzia; safe for swimming (very deep water—wear a lifejacket when canoeing).",
        "sourceAuthority": "Uganda Wildlife Authority (UWA)",
        "officialUrl": "https://ugandawildlife.org",
        "secondaryAuthority": "CDC Travelers' Health",
        "secondaryUrl": "https://cdc.gov"
      },
      {
        "id": "lake_mutanda",
        "name": "Lake Mutanda (Kisoro)",
        "elevationMeters": 1800,
        "status": "Crocodile & Hippo Free • Bilharzia Free",
        "rule": "Clear high-altitude crater lake waters (~1,800m) beneath Mt. Muhavura. Free of Nile crocodiles, hippos, and bilharzia; swim in designated lodge areas.",
        "sourceAuthority": "Uganda Wildlife Authority (UWA)",
        "officialUrl": "https://ugandawildlife.org",
        "secondaryAuthority": "CDC Travelers' Health",
        "secondaryUrl": "https://cdc.gov"
      }
    ],
    "restrictedWaterBodies": [
      {
        "id": "river_nile_kazinga",
        "name": "River Nile (Murchison Falls) & Kazinga Channel",
        "riskLevel": "NO SWIMMING",
        "hazards": [
          "Nile crocodiles",
          "Hippos",
          "Bilharzia (Schistosomiasis)",
          "Fast currents"
        ],
        "rule": "Aggressive Nile crocodiles, dense hippo pods, bilharzia in shoreline backwaters, and fast currents inhabit the Nile and Kazinga Channel. Swimming prohibited by UWA.",
        "sourceAuthority": "Uganda Wildlife Authority (UWA)",
        "officialUrl": "https://ugandawildlife.org",
        "secondaryAuthority": "World Health Organization (WHO)",
        "secondaryUrl": "https://who.int"
      },
      {
        "id": "lake_victoria",
        "name": "Lake Victoria Shorelines & Jinja Backwaters",
        "riskLevel": "HIGH RISK",
        "hazards": [
          "Bilharzia (Schistosomiasis)",
          "Nile crocodiles",
          "Hippos"
        ],
        "rule": "Nile crocodiles, hippos, and high bilharzia concentration inhabit Lake Victoria shorelines and shallow reeds. Swimming strictly discouraged; stick to lodge pools.",
        "sourceAuthority": "World Health Organization (WHO)",
        "officialUrl": "https://who.int",
        "secondaryAuthority": "CDC Travelers' Health",
        "secondaryUrl": "https://cdc.gov"
      }
    ],
    "wildlifeSafetyRules": {
      "nileCrocodiles": {
        "rule": "Maintain >= 15m setback from River Nile, Kazinga Channel, and Lake Victoria banks; never wade in shallow reeds or dangle limbs off launch boats.",
        "sourceAuthority": "Uganda Wildlife Authority (UWA)",
        "officialUrl": "https://ugandawildlife.org"
      },
      "hippos": {
        "rule": "Maintain >= 30m distance from grazing hippos at dawn and dusk; never block a hippo's direct path back to water.",
        "sourceAuthority": "Uganda Wildlife Authority (UWA)",
        "officialUrl": "https://ugandawildlife.org"
      },
      "bilharzia": {
        "rule": "Avoid swimming or wading in untreated freshwater along Lake Victoria shorelines, River Nile, and Kazinga Channel due to schistosomiasis (bilharzia) transmission; high-altitude crater lakes Bunyonyi and Mutanda are documented safe exceptions.",
        "sourceAuthority": "CDC Travelers' Health",
        "officialUrl": "https://cdc.gov",
        "secondaryAuthority": "World Health Organization (WHO)",
        "secondaryUrl": "https://who.int"
      }
    }
  },
